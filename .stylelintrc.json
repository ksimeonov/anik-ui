{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "selector-class-pattern": [
      "^ak-[a-z0-9]+(-[a-z0-9]+)*$",
      {
        "message": "Public class names must match the ak- grammar (see 15-class-api-matrix.md)"
      }
    ],
    "declaration-no-important": true,
    "scss/dollar-variable-pattern": "^ak-[a-z0-9]+(-[a-z0-9]+)*$",
    "custom-property-pattern": "^ak-[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "overrides": [
    {
      "files": ["src/scss/reset.scss"],
      "rules": {
        "declaration-no-important": null,
        "property-no-vendor-prefix": null,
        "selector-class-pattern": null
      }
    }
  ],
  "ignoreFiles": ["dist/**/*"]
}
