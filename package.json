{
  "name": "anik-ui",
  "version": "0.0.0-managed-by-semantic-release",
  "description": "A tiny, framework-agnostic CSS layout and utility system: 12-column grid, container queries, spacing, flexbox and typography utilities. CSS-first, no JavaScript runtime.",
  "keywords": [
    "css",
    "scss",
    "layout",
    "grid",
    "flexbox",
    "container-queries",
    "utilities"
  ],
  "license": "MIT",
  "author": "Kristian Simeonov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksimeonov/anik-ui.git"
  },
  "homepage": "https://github.com/ksimeonov/anik-ui#readme",
  "bugs": {
    "url": "https://github.com/ksimeonov/anik-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "style": "./dist/anik-ui.css",
  "sass": "./src/scss/index.scss",
  "files": [
    "dist",
    "src/scss",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "sass": "./src/scss/index.scss",
      "style": "./dist/anik-ui.css",
      "default": "./dist/anik-ui.css"
    },
    "./css": "./dist/anik-ui.css",
    "./css/min": "./dist/anik-ui.min.css",
    "./reset": "./dist/anik-reset.css",
    "./reset/min": "./dist/anik-reset.min.css",
    "./scss": "./src/scss/index.scss",
    "./scss/reset": "./src/scss/reset.scss",
    "./scss/*": "./src/scss/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:expanded && npm run build:min",
    "build:expanded": "sass --style=expanded --source-map --load-path=src/scss src/scss/index.scss:dist/anik-ui.css src/scss/reset.scss:dist/anik-reset.css",
    "build:min": "cd dist && lightningcss --minify --sourcemap --targets 'chrome 111, firefox 113, safari 16.4' anik-ui.css -o anik-ui.min.css && lightningcss --minify --sourcemap --targets 'chrome 111, firefox 113, safari 16.4' anik-reset.css -o anik-reset.min.css",
    "build:site": "node scripts/build-site.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "stylelint \"src/**/*.scss\"",
    "lint:fix": "stylelint --fix \"src/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && npm run test:api && node --test",
    "test:api": "node scripts/extract-api.mjs --check",
    "api:update": "node scripts/extract-api.mjs --write",
    "local:registry": "npx --yes verdaccio@^6 --config .verdaccio/config.yaml",
    "local:publish": "node scripts/local-publish.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lightningcss-cli": "^1.33.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "semantic-release": "^25.0.9",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-scss": "^14.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || >=24.15.0",
      "onFail": "error"
    }
  }
}
